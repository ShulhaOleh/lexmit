{
    "name": "@shulha/lexmit",
    "version": "0.2.0",
    "description": "Translation status for JSON locale files, reconstructed from Git history",
    "license": "MIT",
    "author": "Oleh Shulha",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ShulhaOleh/lexmit.git"
    },
    "type": "module",
    "packageManager": "bun@1.4.5",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "lexmit": "dist/cli.mjs"
    },
    "exports": {
        "./runtime": {
            "types": "./dist/runtime.d.mts",
            "default": "./dist/runtime.mjs"
        }
    },
    "files": [
        "dist/*.mjs",
        "dist/runtime.d.mts",
        "assets"
    ],
    "scripts": {
        "build": "tsc src/cli.mts src/runtime.mts --ignoreConfig --noCheck --outDir dist --rootDir src --module nodenext --target es2022 --declaration --rewriteRelativeImportExtensions --allowImportingTsExtensions",
        "fmt": "bun fmt --no-script --no-config --no-semi --single-quote --tab-width=4 --trailing-comma=es5 --print-width=100",
        "test": "bun test --timeout 60000",
        "test:node": "node --test \"src/*.test.mts\" \"scripts/*.test.mts\"",
        "release": "bun scripts/release.mts",
        "prepare": "bun scripts/install-hooks.mts",
        "prepublishOnly": "bun run build"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "typescript": "7.0.2"
    }
}
